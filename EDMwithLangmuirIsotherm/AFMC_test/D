FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volTensorField;
    location    "0";
    object      D;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform (4.11e-11 0 0 0 4.11e-11 0 0 0 4.11e-11);

			// (Dx 0 0  0 Dy 0  0 0 Dz)

boundaryField
{
    "inlet|outlet|wall"
    {
        type            calculated;
        value           $internalField;
    }
    
    "sym1|sym2"
    {
    	type		symmetry;
    }
}


