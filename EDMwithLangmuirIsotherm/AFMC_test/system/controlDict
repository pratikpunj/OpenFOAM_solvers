FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     EDMwithLangmuirIsotherm;

startFrom       latestTime;

stopAt          endTime;

//stopAt          writeNow;

endTime         700;

deltaT          0.005;

writeControl    runTime;

writeInterval   1.0;

//purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   7;

runTimeModifiable yes;

// ************************************************************************* //

functions
{
