FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      C;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            uniformFixedValue;
        
        // "table" linearly interpolates between the points defined below
        uniformValue    table
        (
            (0      2.444)   // Start at 2.444
            (60     2.444)   // Hold 2.444 until 20s
            (60.0001  0)       // Drop to 0 immediately after (small time step)
            (10000  0)       // Stay at 0 for the rest of the simulation
        );
        
        value           uniform 2.444; // Initial value at t=0
    }
    wall
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }

}


