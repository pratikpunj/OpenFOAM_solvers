FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     NBFoam;

startFrom       latestTime;


stopAt          endTime;

//stopAt          writeNow;

endTime         650;


deltaT          0.00013;

writeControl    runTime;

writeInterval   1.0;

//purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   7;

runTimeModifiable yes;



// ************************************************************************* //

functions
{
	
	Maximum_Concentration
	{
		#includeEtc "caseDicts/postProcessing/minMax/cellMax"
		enabled 	    true; 	//true or false
		log             true;	//write to screen
		fields  (C);
	}

	Minimum_Concentration
	{
		#includeEtc "caseDicts/postProcessing/minMax/cellMin"
		enabled 	    true; 	//true or false
		log             true;	//write to screen
		fields  (C);
	}
	
	
} 
