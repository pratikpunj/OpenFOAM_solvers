FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default	   bounded Euler;
    
}

gradSchemes
{
    default         cellLimited leastSquares 1;
}

divSchemes
{
    default         bounded fusedGauss limitedLinear 1.0;
}

laplacianSchemes
{
    default          fusedGauss linear limited 0.5;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         limited 0.5;
}


