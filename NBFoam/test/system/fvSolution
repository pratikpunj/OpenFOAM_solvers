FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "C|q"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0.0;
        //minIter		5;
        min		0.0;
    }
    
    
}


SIMPLE
{
    nNonOrthogonalCorrectors 0;
}

cache
{
	"grad(.*)";
}

