FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
	volScalarFieldValue eps 1.0
	volTensorField D (4.11e-11 0 0 0 4.11e-11 0 0 0 4.11e-11)
);

regions
(
    cellToCell
    {
        set             porousCells; // Matches the cellSet name from topoSet
        fieldValues
        (
		volScalarFieldValue eps 0.9142
		volTensorField D (4.5e-7 0 0 0 4.5e-7 0 0 0 4.5e-7)
        );
    }
);




